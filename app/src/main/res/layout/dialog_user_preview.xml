<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#242526"
        android:orientation="vertical">

        <!-- Cover Banner ngẫu nhiên/mặc định -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#3A3B3C"
            android:scaleType="centerCrop" />

        <!-- Phần thân Profile -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="-40dp">

            <!-- Avatar tròn to viền trắng -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDialogAvatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_default"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="#242526"
                app:strokeWidth="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/ivDialogAvatar"
                android:layout_alignBottom="@id/ivDialogAvatar"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDialogName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tên học sinh"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDialogClass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lớp: ..."
                    android:textColor="#B0B3B8"
                    android:textSize="13sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- HÀNG CÁC NÚT TƯƠNG TÁC THEO ẢNH FACEBOOK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center">

            <!-- Nút Nhắn tin -->
            <Button
                android:id="@+id/btnDialogChat"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3A3B3C"
                android:text="💬 Nhắn tin"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:cornerRadius="6dp" />

            <!-- Nút Thêm bạn bè / Trạng thái bạn bè -->
            <Button
                android:id="@+id/btnDialogFriend"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.2"
                android:backgroundTint="#1877F2"
                android:text="👤+ Thêm bạn bè"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <!-- Nút Xem trang cá nhân -->
        <Button
            android:id="@+id/btnDialogViewProfile"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:text="Trang cá nhân ➜"
            android:textColor="#E4E6EB" />

    </LinearLayout>
</androidx.cardview.widget.CardView>